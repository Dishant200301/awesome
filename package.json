{
  "name": "awesome-handmade-ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Monorepo for Awesome Handmade Platform",
  "workspaces": [
    "client",
    "server",
    "admin"
  ],
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:admin": "npm --prefix admin run dev",
    "db:init": "npm --prefix server run db:init",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:admin": "npm --prefix admin run build",
    "build:all": "npm run build:client && npm run build:admin && npm run build:server",
    "build": "npm run build:all",
    "start": "npm --prefix server start",
    "start:server": "npm --prefix server start"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
