<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Do not rewrite real existing files, directories, or assets (JS, CSS, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Support React Router SPA fallback (works for both root subdomain and /admin subfolder)
  RewriteRule ^ index.html [L]
</IfModule>
