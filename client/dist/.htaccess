<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Prevent infinite redirect on index.html
  RewriteRule ^index\.html$ - [L]

  # 2. Allow real existing files, directories, and assets
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route all other requests to index.html (SPA Fallback)
  RewriteRule . /index.html [L]
</IfModule>

# Prevent Hostinger Default Error Pages
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html

# Disable directory listing
Options -Indexes

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching Rules for Production Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Static Assets (Vite hashes file names: safe to cache for 1 year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # HTML & Manifest (Never cache so user gets updates immediately)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # 1-year immutable cache for hashed Vite assets and media
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|woff2?|mp4)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML must revalidate to avoid showing stale code
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Modern Security & Best Practice Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
