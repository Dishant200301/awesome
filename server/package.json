{
  "name": "awesome-handmade-backend",
  "version": "1.0.0",
  "description": "Production-ready scalable e-commerce backend for Awesome Handmade platform using MySQL",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/server.ts",
    "db:init": "npx tsx src/database/init_db.ts",
    "db:sync": "npx tsx src/database/sync_json_to_mysql.ts",
    "build": "tsc && node -e \"import('node:fs').then(fs => { fs.mkdirSync('dist/database', { recursive: true }); fs.copyFileSync('src/database/schema.sql', 'dist/database/schema.sql'); })\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.2",
    "sequelize": "^6.37.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9"
  }
}
